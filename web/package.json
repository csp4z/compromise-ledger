{
  "name": "compromise-ledger-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "pnpm sync-data && vite dev",
    "build": "pnpm sync-data && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@types/node": "^24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17"
  }
}
