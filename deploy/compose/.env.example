# Copy to deploy/compose/.env (git-ignored) and adjust. Never commit the real file.

# Public hostname. "localhost" uses Caddy's local CA, for testing on your machine.
CL_DOMAIN=localhost
# Let's Encrypt account email (expiry notices).
CL_ACME_EMAIL=contact5@kuricove.com
# Host ports, if 80/443 are taken locally.
# CL_HTTP_PORT=8080
# CL_HTTPS_PORT=8443

# Crawler User-Agent contact (defaults to the project address).
# CL_CRAWLER_CONTACT=contact5@kuricove.com

# Host directory for nightly backups (must be writable by UID 10001), and how many to keep.
# CL_BACKUP_HOST_DIR=/srv/compromise-ledger/backups
# CL_BACKUP_KEEP=7

# Alerts (secrets): all optional.
# CL_NTFY_URL=https://ntfy.sh/<your-topic>
# CL_HEALTHCHECKS_URL=https://hc-ping.com/<uuid>
# CL_GITHUB_TOKEN=<fine-grained token with Issues: write on the repo>
