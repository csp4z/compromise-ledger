{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a fact came from, how it was extracted, and how much it is trusted.",
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "crawled_at": {
          "format": "date-time",
          "title": "Crawled At",
          "type": "string"
        },
        "license": {
          "description": "Upstream license (SPDX ID or LicenseRef-*).",
          "maxLength": 128,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_document_id": {
          "description": "ID of the bronze raw document parsed.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Document Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL of the source document.",
          "title": "Source Url"
        },
        "source_url_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the source URL, used instead of source_url for leak-site posts.",
          "title": "Source Url Sha256"
        }
      },
      "required": [
        "raw_document_id",
        "crawled_at",
        "parser_id",
        "parser_version",
        "confidence",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A vendor and product named by a source, before entity resolution.\n\nNames are kept as the source gives them (whitespace normalized only). Resolution maps them\nthrough the vendor alias table to ``Vendor`` and ``Product`` records and a ``has``\nrelationship; names that don't resolve are published as the unresolved list.",
  "properties": {
    "id": {
      "description": "Derived from the natural key with make_id().",
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "product_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Product Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "vendor_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Vendor Name",
      "type": "string"
    },
    "vulnerability_id": {
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Vulnerability Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "vulnerability_id",
    "vendor_name",
    "product_name",
    "provenance"
  ],
  "title": "ProductMention",
  "type": "object",
  "x-ledger-schema-version": "0.6.0"
}
