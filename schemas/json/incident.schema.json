{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a fact came from, how it was extracted, and how much it is trusted.",
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "crawled_at": {
          "format": "date-time",
          "title": "Crawled At",
          "type": "string"
        },
        "license": {
          "description": "Upstream license (SPDX ID or LicenseRef-*).",
          "maxLength": 128,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_document_id": {
          "description": "ID of the bronze raw document parsed.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Document Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL of the source document.",
          "title": "Source Url"
        },
        "source_url_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the source URL, used instead of source_url for leak-site posts.",
          "title": "Source Url Sha256"
        }
      },
      "required": [
        "raw_document_id",
        "crawled_at",
        "parser_id",
        "parser_version",
        "confidence",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A security incident as disclosed in one SEC filing. STIX ``incident``; the fields below go\nin a project extension when exported.\n\nAn 8-K/A amending an earlier disclosure is its own record (``sec_form`` \"8-K/A\"), so counts\nof incidents use original filings only.",
  "properties": {
    "disclosed_on": {
      "description": "Filing date.",
      "format": "date",
      "title": "Disclosed On",
      "type": "string"
    },
    "id": {
      "description": "Derived from the natural key with make_id().",
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Organization Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sec_accession": {
      "pattern": "^\\d{10}-\\d{2}-\\d{6}$",
      "title": "Sec Accession",
      "type": "string"
    },
    "sec_form": {
      "enum": [
        "8-K",
        "8-K/A"
      ],
      "title": "Sec Form",
      "type": "string"
    },
    "sec_item": {
      "description": "The 8-K item that carries the disclosure.",
      "enum": [
        "1.05",
        "8.01"
      ],
      "title": "Sec Item",
      "type": "string"
    },
    "status": {
      "enum": [
        "claimed",
        "reported",
        "confirmed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "organization_id",
    "status",
    "disclosed_on",
    "sec_accession",
    "sec_form",
    "sec_item",
    "provenance"
  ],
  "title": "Incident",
  "type": "object",
  "x-ledger-schema-version": "0.7.0"
}
