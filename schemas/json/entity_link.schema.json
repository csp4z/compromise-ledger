{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a fact came from, how it was extracted, and how much it is trusted.",
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "crawled_at": {
          "format": "date-time",
          "title": "Crawled At",
          "type": "string"
        },
        "license": {
          "description": "Upstream license (SPDX ID or LicenseRef-*).",
          "maxLength": 128,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_document_id": {
          "description": "ID of the bronze raw document parsed.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Document Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL of the source document.",
          "title": "Source Url"
        },
        "source_url_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the source URL, used instead of source_url for leak-site posts.",
          "title": "Source Url Sha256"
        }
      },
      "required": [
        "raw_document_id",
        "crawled_at",
        "parser_id",
        "parser_version",
        "confidence",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A name from another source, resolved to a curated vendor or an SEC-filing organization,\nor to nothing (``target_id`` null).\n\nNames are the CNA that assigned a CVE, the companies that file 8-Ks, and the third parties\ntheir filings name. ``provenance.confidence`` is the matching rule's confidence (0 when the\nname matched nothing), and ``rule`` says which rule matched.",
  "properties": {
    "id": {
      "description": "Derived from the natural key with make_id().",
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "name_kind": {
      "enum": [
        "cna",
        "sec",
        "third-party"
      ],
      "title": "Name Kind",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rule": {
      "anyOf": [
        {
          "enum": [
            "alias",
            "cpe",
            "normalized",
            "squashed",
            "prefix"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule"
    },
    "target_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "target_key": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Vendor slug or SEC CIK.",
      "title": "Target Key"
    },
    "target_type": {
      "anyOf": [
        {
          "enum": [
            "vendor",
            "org"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Type"
    }
  },
  "required": [
    "id",
    "name_kind",
    "name",
    "provenance"
  ],
  "title": "EntityLink",
  "type": "object",
  "x-ledger-schema-version": "0.11.0"
}
