{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a fact came from, how it was extracted, and how much it is trusted.",
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "crawled_at": {
          "format": "date-time",
          "title": "Crawled At",
          "type": "string"
        },
        "license": {
          "description": "Upstream license (SPDX ID or LicenseRef-*).",
          "maxLength": 128,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_document_id": {
          "description": "ID of the bronze raw document parsed.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Document Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL of the source document.",
          "title": "Source Url"
        },
        "source_url_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the source URL, used instead of source_url for leak-site posts.",
          "title": "Source Url Sha256"
        }
      },
      "required": [
        "raw_document_id",
        "crawled_at",
        "parser_id",
        "parser_version",
        "confidence",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A data-breach notification an organization filed with a state attorney general.\nSTIX ``incident``; the fields below go in a project extension when exported.\n\nThe notifier is the organization that owns the data, which is not always the one that was\nbreached. It is kept by the name on the notice, and becomes an ``Organization`` when entity\nresolution can match notices to each other and to SEC filers (Phase 2). The name is left\nout when the notifier looks like one person's professional practice. Dates are the\norganization's own account: when the breach began and ended, when it became aware, and when\nthe notice reached the attorney general. Nothing about the people affected is kept beyond\ntheir number.",
  "properties": {
    "attack_type": {
      "anyOf": [
        {
          "enum": [
            "ransomware",
            "malware",
            "phishing",
            "skimmer",
            "other",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For cyberattacks, the kind the notice reports.",
      "title": "Attack Type"
    },
    "aware_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the organization became aware.",
      "title": "Aware On"
    },
    "breach_ended_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Breach Ended On"
    },
    "breach_started_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Breach Started On"
    },
    "cause": {
      "anyOf": [
        {
          "enum": [
            "cyberattack",
            "unauthorized-access",
            "theft-or-mistake"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cause"
    },
    "id": {
      "description": "Derived from the natural key with make_id().",
      "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "industry": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The regulator's industry label.",
      "title": "Industry"
    },
    "jurisdiction": {
      "const": "US-WA",
      "title": "Jurisdiction",
      "type": "string"
    },
    "notice_id": {
      "description": "The regulator's ID.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Notice Id",
      "type": "string"
    },
    "organization_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The notifier's name; withheld for what looks like an individual's practice.",
      "title": "Organization Name"
    },
    "organization_state": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the organization is based.",
      "title": "Organization State"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "residents_affected": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Residents of the jurisdiction whose data was involved.",
      "title": "Residents Affected"
    },
    "status": {
      "enum": [
        "claimed",
        "reported",
        "confirmed"
      ],
      "title": "Status",
      "type": "string"
    },
    "submitted_on": {
      "description": "When the notice reached the attorney general.",
      "format": "date",
      "title": "Submitted On",
      "type": "string"
    }
  },
  "required": [
    "id",
    "jurisdiction",
    "notice_id",
    "status",
    "submitted_on",
    "provenance"
  ],
  "title": "BreachNotice",
  "type": "object",
  "x-ledger-schema-version": "0.9.0"
}
